# ==== Bot WhatsApp Engineering - konfigurasi environment ====
# Salin ke .env lalu isi. Semua nilai di sini bisa dioverride dari Dashboard.

# ---- Aplikasi ----
BOT_DATA_DIR=./data
BOT_TIMEZONE=Asia/Makassar
BOT_HOST=0.0.0.0
BOT_PORT=8080
# Password dashboard. Kosongkan = dashboard terbuka tanpa login (hanya untuk lokal).
BOT_DASHBOARD_PASSWORD=
BOT_SECRET_KEY=ganti-dengan-string-acak-panjang

# ---- WAHA (self-hosted) ----
# Base URL WAHA dari host aplikasi ini. Kalau WAHA di container yang sama,
# gunakan http://waha:3000. Dari browser dashboard: http://localhost:3000
BOT_WAHA_BASE_URL=http://waha:3000
# API key WAHA (header X-Api-Key). WAHA terbaru mewajibkan key ini.
# WAHA & aplikasi memakai key yang sama. Isi dengan nilai acak panjang sebelum
# menjalankan Docker Compose; Compose akan menolak nilai yang kosong.
BOT_WAHA_API_KEY=
# Nama session WAHA yang dipakai bot ini.
BOT_WAHA_SESSION=engineering
# Login dashboard WAHA (http://localhost:3000)
BOT_WAHA_ADMIN_USER=admin
BOT_WAHA_ADMIN_PASSWORD=
# Token untuk memvalidasi webhook masuk dari WAHA (WAHA_SEND_WEBHOOKS_TO_WEBHOOK).
BOT_WEBHOOK_TOKEN=ganti-token-acak
# URL aplikasi yang bisa dijangkau container WAHA untuk memanggil webhook.
# Jangan pakai localhost/127.0.0.1 (dari container WAHA itu menunjuk ke dirinya sendiri).
BOT_PUBLIC_URL=http://app:8080

# ---- Google Sheets (service account) ----
# Path ke file JSON service account (volume mount di docker compose).
BOT_GOOGLE_SA_FILE=/run/secrets/service-account.json
# ID spreadsheet tujuan (bisa juga diisi dari Dashboard).
BOT_SPREADSHEET_ID=
# Nama tab: log pesan, tab ticket, tab dashboard ringkasan.
BOT_SHEET_TICKETS=BOBOT_TICKETS
BOT_SHEET_LOG=BOBOT_LOG
BOT_SHEET_SUMMARY=BOBOT_SUMMARY

# ---- Scheduler ----
BOT_DAILY_SUMMARY_HOUR=17
BOT_DAILY_SUMMARY_MINUTE=0

# ---- Diagnostik (sementara) ----
# Log setiap event webhook + keputusan pipeline (pesan masuk / grup nonaktif / dll)
BOT_DEBUG_WEBHOOK=false
# false = webhook diterima tanpa validasi token (untuk isolates masalah 401)
BOT_WEBHOOK_REQUIRE_TOKEN=true
